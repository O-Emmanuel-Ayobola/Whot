{
  "name": "whot-multiplayer-phase2",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json",
    "typecheck:frontend": "tsc -p frontend/tsconfig.json",
    "build:frontend": "vite build frontend --config frontend/vite.config.ts",
    "build": "npm run typecheck && npm run typecheck:frontend && npm run build:frontend",
    "dev:frontend": "vite --config frontend/vite.config.ts",
    "dev": "npx netlify dev",
    "verify": "npm test && npm run build"
  },
  "dependencies": {
    "@netlify/blobs": "^11.1.7",
    "@netlify/functions": "^6.0.3",
    "@vitejs/plugin-react": "^5.0.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "vite": "^7.1.7"
  },
  "devDependencies": {
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0",
    "@types/node": "^20.0.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
